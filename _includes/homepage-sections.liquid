<section class="section-block" id="news" aria-labelledby="news-title">
  <div class="section-label">
    <h2 id="news-title">News</h2>
  </div>
  <ol class="news-list section-content">
    {% assign updates = site.news | sort: 'date' | reverse %}
    {% for item in updates %}
      <li>
        <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%d %b %Y' }}</time>
        <div>{{ item.content }}</div>
      </li>
    {% endfor %}
  </ol>
</section>
<section class="section-block" id="publications" aria-labelledby="publications-title">
  <div class="section-label">
    <h2 id="publications-title">Publications & manuscripts</h2>
  </div>
  <div class="section-content">
    {% include profile-publications.liquid %}
  </div>
</section>
<section class="section-block" id="research" aria-labelledby="research-title">
  <div class="section-label">
    <h2 id="research-title">Research experience</h2>
  </div>
  <div class="section-content">
    {% for item in site.data.homepage.research %}
      <article class="research-entry">
        <div class="entry-heading">
          <h3>
            <a href="{{ item.url }}">{{ item.institution }}</a><span> · {{ item.lab }}</span>
          </h3>
          <p class="date">{{ item.dates }}</p>
        </div>
        <p class="entry-meta">{{ item.role }} · {{ item.supervisor | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        <p>{{ item.description }}</p>
      </article>
    {% endfor %}
  </div>
</section>
<section class="section-block contact-block" id="contact" aria-labelledby="contact-title">
  <div class="section-label">
    <h2 id="contact-title">Contact</h2>
  </div>
  <div class="section-content">
    <div class="contact-profiles">
      {% include profile-socials.liquid %}
    </div>
  </div>
</section>
