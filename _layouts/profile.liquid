<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>
      {% if page.url != '/' %}{{ page.title | escape }} · {% endif %}
      {{ site.title | escape }}
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip | escape }}">
    <meta name="author" content="Soroush Esfahanian">
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:title" content="Soroush Esfahanian · Research">
    <meta property="og:description" content="{{ site.description | strip | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ '/assets/img/prof_pic.jpg' | absolute_url }}">
    <link rel="icon" href="{{ '/favicon.ico' | relative_url }}" sizes="16x16 32x32 48x48" type="image/x-icon">
    <link rel="icon" href="{{ '/assets/img/favicon-96.png' | relative_url }}" sizes="96x96" type="image/png">
    <link rel="icon" href="{{ '/assets/img/monogram.svg' | relative_url }}" sizes="any" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ '/assets/img/apple-touch-icon.png' | relative_url }}" sizes="180x180">
    <link rel="stylesheet" href="{{ '/assets/css/profile.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/academicons.min.css' | relative_url }}">
    <script src="{{ '/assets/js/profile.js' | relative_url }}"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="{{ '/' | relative_url }}" aria-label="Soroush Esfahanian — home"
        ><img src="{{ '/assets/img/monogram.svg' | relative_url }}" alt="" width="32" height="32"><span>Home</span></a
      >
      <nav aria-label="Main navigation">
        <a href="{{ '/#news' | relative_url }}">News</a>
        <a href="{{ '/#publications' | relative_url }}">Publications</a>
        <a href="{{ '/#research' | relative_url }}">Research</a>
        <a href="{{ '/#contact' | relative_url }}">Contact</a>
        <a class="nav-cv" href="{{ site.data.socials.cv_pdf | relative_url }}" aria-label="View CV (PDF)"
          ><span class="profile-icon icon-pdf" aria-hidden="true"></span>CV<span class="file-label">PDF</span></a
        >
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false" hidden>Dark</button>
    </header>
    <main id="main" class="{% if page.url == '/' %}homepage{% else %}shell{% endif %}">{{ content }}</main>
    <footer class="site-footer shell">
      <span>© {{ site.time | date: '%Y' }} Soroush Esfahanian</span>
      <span>Built with Jekyll · <a href="https://github.com/Soroushesfn/soroushesfn.github.io">Source</a></span>
    </footer>
  </body>
</html>
